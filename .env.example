ANTHROPIC_API_KEY=
FAL_KEY=
NOTION_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
OPENAI_API_KEY=

# Per-channel narrator voice id (ElevenLabs). Pick a serious French male for banditbiographies.
ELEVENLABS_VOICE_BANDITBIOGRAPHIES=

# One Notion DB id per channel (see README for schema).
NOTION_DB_BANDITBIOGRAPHIES=

# OpenAI Whisper API (used by transcribe_youtube). Source mp3 must be ≤25MB.
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=fr

# Optional — sensible defaults exist in src/config.ts
CLAUDE_MODEL=claude-opus-4-7
SEEDANCE_MODEL=bytedance/seedance-2.0/fast/text-to-video
HOOK_DURATION_SECONDS=10
HOOK_RESOLUTION=720p
VIDEO_ASPECT_RATIO=9:16
ELEVENLABS_MODEL=eleven_multilingual_v2

# Selected at runtime via CLI, not here:
#   CHANNEL=banditbiographies YOUTUBE_URL=https://youtu.be/... npm start
