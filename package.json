{
  "name": "longform-tiktok-viral-creator-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Turns YouTube source videos into ~1m05–1m30 vertical narrated micro-docs. Hook = Seedance 2.0 (fal.ai), body = Pexels stock + ElevenLabs voice, montage = Hyperframes. Channels: banditbiographies.",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "start:banditbiographies": "CHANNEL=banditbiographies npx tsx src/index.ts",
    "upload-source": "npx tsx scripts/upload-source.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@anthropic-ai/claude-code": "^2.1.104",
    "@fal-ai/client": "^1.2.0",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^17.4.1",
    "hyperframes": "^0.4.32",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
